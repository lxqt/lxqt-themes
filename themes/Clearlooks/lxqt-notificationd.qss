Notification {
    color: #1a1a1a;
    background: #edeceb;
	background-clip: border;
	background-origin: content;
    border: 1px solid #aaaaaa;
	border-radius: 3px;
}

QLabel {
    color: #1a1a1a;
}

#appLabel {
    font-weight: bold;
}

#closeButton {
    color: #1a1a1a;
    background: transparent;
    border: 4px solid transparent;
    border-image: none;
    margin: 0px;
    padding: 1px;
    qproperty-icon: url(assets/icons/cancel.svg);
}

#closeButton:hover {
    border-image: url(assets/buttons/button-hover.svg);
}

#closeButton:pressed {
    border-image: url(assets/buttons/button-pressed.svg);
}
