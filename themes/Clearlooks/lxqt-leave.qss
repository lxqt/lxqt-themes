/* Main dialog window */
QDialog {
    color: #1a1a1a;
    background: #edeceb;
    border: 1px solid #aaaaaa;
}

/* Caption colors */
QLabel {
    color: #1a1a1a;
    background: transparent;
}

/* Session action buttons */
QAbstractItemView {
    color: #1a1a1a;
    background: #ffffff;
    /* note: must use solid color 1px image for bg color */
    background-image: url(assets/menus/bg.svg);
    border: 1px solid #aaaaaa;
	border-radius: 3px;
}

/* Confirmation dialog buttons */
QPushButton {
    color: #1a1a1a;
    background: transparent;
    border: 4px solid transparent;
    border-image: url(assets/buttons/button.svg) 4;
    padding: 3px 18px;
    margin: 0px 6px;
}

QToolButton {
    color: #000000;
    background: transparent;
    border: 4px solid transparent;
    border-image: url(assets/buttons/button.svg) 4;
    padding: 3px 4px;
    margin: 0px 6px;
}

QPushButton:hover,
QToolButton:hover {
    border-image: url(assets/buttons/button-hover.svg) 4;
}

QPushButton:pressed,
QToolButton:pressed {
    border-image: url(assets/buttons/button-pressed.svg) 4;
}
