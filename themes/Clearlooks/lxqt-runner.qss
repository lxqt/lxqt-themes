/* Dropdown panel */
#panel {
    color: #1a1a1a;
    background: #edeceb;
    border: 1px solid #aaaaaa;
}

/* Buttons */
QToolButton {
    color: #1a1a1a;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
	padding: 3px;
}

QToolButton:hover {
    color: #1a1a1a;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:0.49 #ffffff, stop:0.5 #fafaf9, stop:1 #edeceb);
    border: 1px solid #928f8d;
}

QToolButton:pressed {
    color: #1a1a1a;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ccc9c7, stop:0.12 #d5d3d2, stop:0.13 #d8d6d4, stop:0.4 #cfcdcb, stop:0.5 #cbc8c6, stop:1 #c0bdba);
    border: 1px solid #888582;
}

QToolButton::menu-indicator {
    image: none;
}

#closeButton {
    qproperty-icon: url(assets/icons/cancel.svg);
    qproperty-iconSize: 16px;
}

#actionButton {
    qproperty-icon: url(assets/icons/menu.svg);
    qproperty-iconSize: 16px;
}

/* Command box */
#commandEd {
    color: #000000;
    background: #ffffff;
    selection-color: #ffffff;
    selection-background-color: #86abd9;
    border: 1px solid #73706d;
    border-radius: 3px;
    padding: 2px;
    font: normal;
}

/* Search results */
#commandList {
    color: #1a1a1a;
    background: #ffffff;
    border-bottom: 1px solid #aaaaaa;
    border-left: 1px solid #aaaaaa;
    border-right: 1px solid #aaaaaa;
    border-top: none;
}

#commandList::item,
#commandList::item:alternate {
    color: #1a1a1a;
    background: #ffffff;
}

#commandList::item:hover,
#commandList::item:selected,
#commandList::item:selected:hover {
    color: #ffffff;
    background: #86abd9;
}

/* Menus */
QMenu {
    color: #000000;
    background: #ffffff;
    border: 1px solid #aaaaaa;
    min-width: 120px;
    margin: 0px;
    padding: 0px;
}

QMenu::item {
    color: #000000;
    background: transparent;
    border: 1px solid transparent;
    border-image: none;
    min-width: 120px;
    min-height: 22px;
    margin: 0px;
    padding: 0px 5px 0px 3px;
}

QMenu::separator {
    color: #aaaaaa;
    background: #aaaaaa;
    height: 1px;
}

QMenu::item:hover,
QMenu::item:selected {
    color: #ffffff;
    border-image: url(assets/menus/menuitem.svg);
}

QMenu::item:disabled {
    color: #a0a0a0;
}

QMenu::icon {
    margin-left: 5px;
}

/* Scrollbars */
QScrollBar:vertical {
    color: transparent;
    background: #d6d4d2;
    border: 1px solid #a19d9a;
    width: 15px;
    padding: 13px -1px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #a2c0e6, stop:0.49 #98b9e2, stop:0.50 #90b3de, stop:1 #84aad8);
    background-image: url(assets/scrollbars/grip-v.svg);
    background-repeat: no-repeat;
    background-position: center;
    background-attachment: fixed;
    border: 1px groove #5e7ea4;
    width: 15px;
    min-height: 24px;
    margin: 0px;
}

QScrollBar::handle:hover:vertical,
QScrollBar::handle:pressed:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #adc9eb, stop:0.49 #a2c1e7, stop:0.50 #9abbe3, stop:1 #8db1dd);
    background-image: url(assets/scrollbars/grip-v.svg);
    background-repeat: no-repeat;
    background-position: center;
    background-attachment: fixed;
}

QScrollBar::add-line:vertical {
    color: #1a1a1a;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #fdfdfd, stop:0.49 #f3f3f2, stop:0.5 #edeceb, stop:1 #e4e3e1);
    background-image: url(assets/scrollbars/arrow-down.svg);
    background-repeat: no-repeat;
    background-position: center center;
    background-attachment: fixed;
    border: 1px solid #868482;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

QScrollBar::add-line:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #fefefe, stop:0.5 #f6f5f5, stop:0.51 #f0efee, stop:1 #e6e5e4);
    background-image: url(assets/scrollbars/arrow-down.svg);
    background-repeat: no-repeat;
    background-position: center center;
    background-attachment: fixed;
}

QScrollBar::add-line:vertical:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #e3e1e0, stop:0.5 #dad9d7, stop:0.51 #d5d3d1, stop:1 #cdcac8);
    background-image: url(assets/scrollbars/arrow-down.svg);
    background-repeat: no-repeat;
    background-position: center center;
    background-attachment: fixed;
}

QScrollBar::sub-line:vertical {
    color: #1a1a1a;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #fdfdfd, stop:0.49 #f3f3f2, stop:0.5 #edeceb, stop:1 #e4e3e1);
    background-image: url(assets/scrollbars/arrow-up.svg);
    background-repeat: no-repeat;
    background-position: center center;
    background-attachment: fixed;
    border: 1px solid #868482;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
}

QScrollBar::sub-line:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #fefefe, stop:0.5 #f6f5f5, stop:0.51 #f0efee, stop:1 #e6e5e4);
    background-image: url(assets/scrollbars/arrow-up.svg);
    background-repeat: no-repeat;
    background-position: center center;
    background-attachment: fixed;
}

QScrollBar::sub-line:vertical:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #e3e1e0, stop:0.5 #dad9d7, stop:0.51 #d5d3d1, stop:1 #cdcac8);
    background-image: url(assets/scrollbars/arrow-up.svg);
    background-repeat: no-repeat;
    background-position: center center;
    background-attachment: fixed;
}
