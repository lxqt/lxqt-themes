/* ----------Popup---------- */
Notification {
    color: #dedede;
    background: #202020;
    border: 1px solid #393939;
    border-radius: 16px;
}

QLabel {
    color: #dedede;
}

#appLabel {
    font-weight: bold;
}

QToolButton {
    background: #2a2a2a;
    border: 1px solid #393939;
    border-radius: 16px;
    padding: 6px 7px;
    qproperty-icon: url(icons/window-close.svg);
}

QToolButton:hover {
    background: #383838;
    border: 1px solid #666666;
}

QToolButton:pressed {
    background: #303030;
    border: 1px solid #4a4a4a;
}
